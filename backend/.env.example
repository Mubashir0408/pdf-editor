# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS (required in production) ---
# Comma-separated list of the exact origin(s) your deployed frontend is
# served from, e.g. https://app.example.com,https://example.com
# In development, any http://localhost:<port> is allowed automatically —
# this only matters once NODE_ENV=production.
FRONTEND_ORIGIN=

# --- Uploads ---
# Both paths are resolved relative to the backend/ directory.
UPLOAD_PATH=uploads
# Max upload size in bytes (default: 100MB)
MAX_UPLOAD_SIZE=104857600
# Where processed/generated output files (merged PDFs, ...) are written
GENERATED_PATH=generated
# How long (ms) an uploaded/generated file may sit on disk before the
# periodic cleanup sweep deletes it (default: 1 hour)
TEMP_FILE_MAX_AGE_MS=3600000
