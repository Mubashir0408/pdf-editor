# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Uploads ---
# Both paths are resolved relative to the backend/ directory.
UPLOAD_PATH=uploads
# Max upload size in bytes (default: 100MB)
MAX_UPLOAD_SIZE=104857600
# Where processed/generated output files (merged PDFs, ...) are written
GENERATED_PATH=generated

# --- AI (reserved — not used until the AI milestone) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Auth (reserved — not used until the auth milestone) ---
JWT_SECRET=change-me-before-enabling-auth
