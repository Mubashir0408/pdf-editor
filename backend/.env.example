# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (Supabase PostgreSQL via Prisma) ---
# From your Supabase project: Project Settings -> Database -> Connection string.
# DATABASE_URL = the "Transaction pooler" string (port 6543) — used for all
#                 normal query traffic. Append ?pgbouncer=true.
# DIRECT_URL   = the "Direct connection" string (port 5432) — used only by
#                 Prisma Migrate, which needs a non-pooled connection.
# Both use the same password; only the host/port differ.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Uploads ---
# Both paths are resolved relative to the backend/ directory.
UPLOAD_PATH=uploads
# Max upload size in bytes (default: 100MB)
MAX_UPLOAD_SIZE=104857600
# Where processed/generated output files (merged PDFs, ...) are written
GENERATED_PATH=generated

# --- AI (reserved — not used until the AI milestone) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Auth (reserved — not used until the auth milestone) ---
JWT_SECRET=change-me-before-enabling-auth
