{
  "name": "docuflow-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for DocuFlow AI — file upload and (future) PDF processing services.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.8.1",
    "@napi-rs/canvas": "^1.0.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^5.10.1",
    "file-type": "^22.0.1",
    "google-translate-api-x": "^10.7.3",
    "helmet": "^8.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "puppeteer": "^25.4.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.1"
