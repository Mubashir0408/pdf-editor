# Copy to .env.local (which is gitignored) and adjust for your environment.

# The public URL this frontend is deployed at — used to build canonical
# URLs, Open Graph/Twitter metadata, and sitemap.xml. Defaults to
# http://localhost:3000 if unset, which is fine for local development but
# must be set to the real deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (auth) ---
# Project Settings -> API in your Supabase dashboard. Public values — safe
# to expose to the browser. The service role key is backend-only and must
# NEVER be set here (see backend/.env.example).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SECRET, server-only. Never set NEXT_PUBLIC_* on this one.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sentry (error monitoring) ---
# Project Settings -> Client Keys (DSN) in your Sentry dashboard. A DSN is
# meant to be public (it can only submit events, not read data), but it's
# still kept out of source control here like every other environment value.
NEXT_PUBLIC_SENTRY_DSN=

# --- API (formerly the separate Express backend, now part of this app) ---
# Max upload size in bytes (default: 100MB).
MAX_UPLOAD_SIZE=104857600
# How long (ms) a Storage object may sit before the cron sweep deletes it.
TEMP_FILE_MAX_AGE_MS=3600000

# --- AI Chat (OpenRouter) ---
# Free API key from https://openrouter.ai/keys. SECRET, server-only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Resend (signup welcome email) ---
# API key from https://resend.com/api-keys. SECRET, server-only. Signup still
# succeeds without this set — the welcome email is just skipped.
RESEND_API_KEY=
# Must be a verified domain/sender in Resend, or their sandbox address
# (works without domain verification, for testing only).
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Vercel Cron (cleanup sweep) ---
# Any random string — verifies requests to /api/cron/cleanup actually came
# from Vercel Cron, not the public internet.
CRON_SECRET=
